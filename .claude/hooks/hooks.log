ment;\\n#[cfg(feature = \\\"mock\\\")]\\nuse crate::frontend_prelude::leptos::web_sys::HtmlInputElement;\\n// event_target helper\\n#[cfg(not(feature = \\\"mock\\\"))]\\nuse tachys::dom::event_target;\\n#[cfg(feature = \\\"mock\\\")]\\nuse tachys_mock::mock_dom_helpers::event_target;\\n\\nuse super::styles::Upload;\\n\\n/// Upload modal view\\n///\\n/// Displays a modal for uploading documents with file selection and progress tracking\\n#[component]\\npub fn View() -> impl IntoView {\\n    let state = State::expect_context();\\n    let dashboard_state = DashboardState::expect_context();\\n\\n    let handle_close = Callback::new(move |()| {\\n        crate::routes::AppRoutes::Dashboard(crate::routes::DashboardRoutes::Documents(\\n            crate::routes::DocumentsRoutes::Index,\\n        ))\\n        .navigate();\\n    });\\n\\n    let handle_upload = Callback::new(move |()| {\\n        if state.selected_files().get().is_empty() {\\n            return;\\n        }\\n\\n        state.upload_state().set(UploadState::Uploading);\\n        state\\n            .upload_progress()\\n            .set(PercentageU8::try_new(0).expect(\\\"0 is always a valid percentage\\\"));\\n\\n        // Mock upload for development (client-side only)\\n        #[cfg(all(feature = \\\"testing\\\", feature = \\\"client\\\"))]\\n        {\\n            let state_clone = state;\\n            leptos::task::spawn_local(async move {\\n                for i in 1..=10 {\\n                    timeout(200).await;\\n                    let progress = PercentageU8::try_new(i * 10)\\n                        .expect(\\\"values 10-100 are always valid percentages\\\");\\n                    state_clone.upload_progress().set(progress);\\n                }\\n\\n                state_clone.upload_state().set(UploadState::Success);\\n                let file_count = state_clone.selected_files().get().len();\\n                state_clone.upload_success_message().set(format!(\\n                    \\\"{} file{} uploaded successfully\\\",\\n                    file_count,\\n                    if file_count == 1 { \\\"\\\" } else { \\\"s\\\" }\\n                ));\\n\\n                timeout(2000).await;\\n                crate::routes::AppRoutes::Dashboard(crate::routes::DashboardRoutes::Documents(\\n                    crate::routes::DocumentsRoutes::Index,\\n                ))\\n                .navigate();\\n            });\\n        }\\n    });\\n\\n    // Signal::derive is used here because the State struct contains PercentageU8\\n    // which doesn't implement Default, making the #[frontend_state] macro impractical.\\n    // This file is excluded from the Signal::derive validation rule for this reason.\\n    let is_disabled = Signal::derive(move || state.selected_files().get().is_empty());\\n\\n    view! {\\n        <Modal\\n            title=\\\"Upload Documents\\\"\\n            on_close=handle_close\\n            width=ModalWidth::Large\\n            footer=SingleButtonFooter::builder()\\n                .text(\\\"Upload\\\")\\n                .on_click(handle_upload)\\n                .disabled_state(ButtonDisabledState::builder()\\n                    .is_disabled(is_disabled)\\n                    .disabled_message(\\\"Select files to upload\\\")\\n                    .build())\\n                .build()\\n        >\\n            {move || render_body(state, dashboard_state)}\\n        </Modal>\\n    }\\n}\\n\\nfn render_body(\\n    state: Field<super::state::State>,\\n    dashboard_state: Field<DashboardState>,\\n) -> impl IntoView {\\n    view! {\\n        <div>\\n            <p class={Upload::default().subtitle().build()}>\\n                \\\"Select files or folders to upload to your document library\\\"\\n            </p>\\n\\n            {render_target_directory(state)}\\n\\n            <Show\\n                when=move || state.selected_files().get().is_empty() && !matches!(state.upload_state().get(), UploadState::Uploading)\\n                fallback=move || {\\n                    match state.upload_state().get() {\\n                        UploadState::Idle => render_file_list(state).into_any(),\\n                        UploadState::Uploading => render_upload_progress(state).into_any(),\\n                        UploadState::Success => render_success_message(state).into_any(),\\n                        UploadState::Failed => render_error_message().into_any(),\\n                    }\\n                }\\n            >\\n                {render_upload_area(state, dashboard_state)}\\n            </Show>\\n        </div>\\n    }\\n}\\n\\nfn render_target_directory(state: Field<super::state::State>) -> impl IntoView {\\n    view! {\\n        <div class={Upload::default().section().build()}>\\n            <label class={Upload::default().label().build()}>\\n                \\\"Target Directory\\\"\\n            </label>\\n            <div class={Upload::default().input_container().build()}>\\n                <span class={Upload::default().directory_prefix().build()}>\\n                    \\\"/\\\"\\n                </span>\\n                <input\\n                    type=\\\"text\\\"\\n                    value=move || state.target_directory().get().display().to_string()\\n                    on:input=move |e| {\\n                        let target = event_target::<HtmlInputElement>(&e);\\n                        state.target_directory().set(PathBuf::from(target.value()));\\n                    }\\n                    class={Upload::default().input().build()}\\n                />\\n            </div>\\n            <p class={Upload::default().hint().build()}>\\n                {move || format!(\\\"Files will be uploaded to this directory. Default is '{}'\\\",\\n                    state.target_directory().get().display())}\\n            </p>\\n        </div>\\n    }\\n}\\n\\nfn render_upload_area(\\n    state: Field<super::state::State>,\\n    dashboard_state: Field<DashboardState>,\\n) -> impl IntoView {\\n    let handle_file_select = create_file_select_handler(state, dashboard_state);\\n    let handle_directory_select = create_file_select_handler(state, dashboard_state);\\n\\n    let accept_attr = helpers::get_accept_attr();\\n    let supported_formats = helpers::get_supported_formats();\\n\\n    view! {\\n        <div class={Upload::default().section().build()}>\\n            <div class={Upload::default().drop_zone().build()}>\\n                <HeroIcon icon=HeroIconName::FolderOpen size=HeroIconSize::ExtraLarge />\\n                <p class={Upload::default().upload_hint().build()}>\\n                    \\\"Click or drag files to upload\\\"\\n                </p>\\n                <p class={Upload::default().subtitle().build()}>\\n                    {format!(\\\"Supported formats: {supported_formats}\\\")}\\n                </p>\\n            </div>\\n\\n            <input\\n                type=\\\"file\\\"\\n                id=\\\"file-upload\\\"\\n                multiple\\n                accept=accept_attr\\n                class={Upload::default().hidden_input().build()}\\n                on:change=handle_file_select\\n            />\\n            <input\\n                type=\\\"file\\\"\\n                id=\\\"directory-upload\\\"\\n                prop:webkitdirectory=true\\n                prop:directory=true\\n                class={Upload::default().hidden_input().build()}\\n                on:change=handle_directory_select\\n            />\\n\\n            <div class={Upload::default().button_group().build()}>\\n                <Button\\n                    custom_styles={\\n                        let mut upload = Upload::default();\\n                        upload.select_button();\\n                        upload.styles\\n                    }\\n                    test_id=helpers::test_ids::SELECT_FILES_BUTTON\\n                    on_click=move || trigger_file_input(\\\"file-upload\\\")\\n                >\\n                    <HeroIcon icon=HeroIconName::DocumentPlus size=HeroIconSize::Medium />\\n                    <span>\\\"Select Files\\\"</span>\\n                </Button>\\n                <Button\\n                    custom_styles={\\n                        let mut upload = Upload::default();\\n                        upload.select_button();\\n                        upload.styles\\n                    }\\n                    test_id=helpers::test_ids::SELECT_DIRECTORY_BUTTON\\n                    on_click=move || trigger_file_input(\\\"directory-upload\\\")\\n                >\\n                    <HeroIcon icon=HeroIconName::Folder size=HeroIconSize::Medium />\\n                    <span>\\\"Select Directory\\\"</span>\\n                </Button>\\n            </div>\\n        </div>\\n    }\\n}\\n\\nfn render_file_list(state: Field<super::state::State>) -> impl IntoView {\\n    let remove_file = create_remove_file_handler(state);\\n\\n    view! {\\n        <div class={Upload::default().section().build()}>\\n            <p class={Upload::default().file_count().build()}>\\n                {move || {\\n                    let count = state.selected_files().get().len();\\n                    format!(\\\"{count} files ready for upload\\\")\\n                }}\\n            </p>\\n            <div class={Upload::default().file_list().build()}>\\n                <For\\n                    each=move || state.selected_files().get()\\n                    key=|file| file.path.clone()\\n                    children=move |file| {\\n                        let file_path = file.path.clone();\\n                        let file_name = file.file_name().to_string();\\n                        let file_size = file.size.clone();\\n                        let file_type = file.file_type;\\n                        let remove = remove_file.clone();\\n\\n                        view! {\\n                            <div\\n                                data-testid=helpers::test_ids::file_item_testid(&file_name)\\n                                class={Upload::default().file_item().build()}\\n                            >\\n                                <div class={Upload::default().file_item_content().build()}>\\n                                    <HeroIcon icon=HeroIconName::DocumentText size=HeroIconSize::Medium />\\n                                    <div class={Upload::default().file_details().build()}>\\n                                        <p class={Upload::default().file_name().build()}>\\n                                            {file_name.clone()}\\n                                        </p>\\n                                        <div class={Upload::default().file_metadata().build()}>\\n                                            <span class={Upload::default().file_type_badge().build()}>\\n                                                {file_type.to_string()}\\n                                            </span>\\n                                            <span class={Upload::default().file_size().build()}>\\n                                                {file_size}\\n                                            </span>\\n                                        </div>\\n                                    </div>\\n                                </div>\\n                                <Button\\n                                    text=\\\"×\\\"\\n                                    custom_styles={\\n                                        let mut upload = Upload::default();\\n                                        upload.remove_button();\\n                                        upload.styles\\n                                    }\\n                                    on_click=move || remove(file_path.clone())\\n                                />\\n                            </div>\\n                        }\\n                    }\\n                />\\n            </div>\\n        </div>\\n    }\\n}\\n\\nfn render_upload_progress(state: Field<super::state::State>) -> impl IntoView {\\n    view! {\\n        <div class={Upload::default().section().build()}>\\n            <p class={Upload::default().upload_status().build()}>\\n                \\\"Uploading files...\\\"\\n            </p>\\n            <div class={Upload::default().progress_container().build()}>\\n                <div\\n                    class={Upload::default().progress_fill().build()}\\n                    style=move || format!(\\\"width: {}\\\", state.upload_progress().get())\\n                />\\n            </div>\\n            <p class={Upload::default().progress_text().build()}>\\n                {move || state.upload_progress().get().to_string()}\\n            </p>\\n        </div>\\n    }\\n}\\n\\nfn render_success_message(state: Field<super::state::State>) -> impl IntoView {\\n    view! {\\n        <div class={Upload::default().section().build()}>\\n            <div class={Upload::default().success_icon_container().build()}>\\n                <HeroIcon icon=HeroIconName::CheckCircle size=HeroIconSize::ExtraLarge />\\n            </div>\\n            <p class={Upload::default().success_message().build()}>\\n                {move || state.upload_success_message().get()}\\n            </p>\\n        </div>\\n    }\\n}\\n\\nfn render_error_message() -> impl IntoView {\\n    view! {\\n        <div class={Upload::default().section().build()}>\\n            <p class={Upload::default().error_message().build()}>\\n                \\\"Upload failed. Please try again.\\\"\\n            </p>\\n        </div>\\n    }\\n}\\n\\n/// File select handler - browser-only implementation\\n#[cfg(not(feature = \\\"mock\\\"))]\\nfn create_file_select_handler(\\n    state: Field<super::state::State>,\\n    dashboard_state: Field<DashboardState>,\\n) -> impl Fn(ev::Event) + Clone + 'static {\\n    move |e: ev::Event| {\\n        let Some(target) = e.target() else { return };\\n        let Ok(input) = target.dyn_into::<HtmlInputElement>() else {\\n            return;\\n        };\\n        if let Some(files) = input.files() {\\n            leptos::task::spawn_local(async move {\\n                // Process all files\\n                let processing_result =\\n                    super::processing::process_file_selection(&files, dashboard_state).await;\\n\\n                // Update state with all files\\n                state.selected_files().update(|files| {\\n                    files.clear();\\n                    files.extend(processing_result.all_files);\\n                });\\n\\n                // Show ZIP extraction notification\\n                if processing_result.zip_count > 0 {\\n                    let message = super::processing::format_zip_notification(\\n                        processing_result.zip_count,\\n                        processing_result.zip_extracted_count,\\n                    );\\n                    dashboard_state.notifications().success(&message);\\n                }\\n\\n                // Show skipped files notification\\n                if processing_result.skipped_count > 0 {\\n                    let message = super::processing::format_skipped_notification(\\n                        processing_result.skipped_count,\\n                    );\\n                    dashboard_state.notifications().info(&message);\\n                }\\n            });\\n        }\\n    }\\n}\\n\\n/// File select handler - mock stub (file uploads can't be mocked at browser level)\\n#[cfg(feature = \\\"mock\\\")]\\nfn create_file_select_handler(\\n    _state: Field<super::state::State>,\\n    _dashboard_state: Field<DashboardState>,\\n) -> impl Fn(ev::Event) + Clone + 'static {\\n    move |_e: ev::Event| {\\n        // In mock mode, file selection is not available\\n        // Tests should set state directly rather than simulating file selection\\n    }\\n}\\n\\nfn create_remove_file_handler(\\n    state: Field<super::state::State>,\\n) -> impl Fn(PathBuf) + Clone + 'static {\\n    move |path: PathBuf| {\\n        state.selected_files().update(|files| {\\n            files.remove(path.as_path());\\n        });\\n    }\\n}\\n\\n/// Trigger file input click - browser-only implementation\\n#[cfg(not(feature = \\\"mock\\\"))]\\nfn trigger_file_input(id: &str) {\\n    if let Some(input) = web_sys::window()\\n        .and_then(|w| w.document())\\n        .and_then(|d| d.get_element_by_id(id))\\n        .and_then(|e| e.dyn_into::<HtmlInputElement>().ok())\\n    {\\n        input.click();\\n    }\\n}\\n\\n/// Trigger file input click - mock stub\\n#[cfg(feature = \\\"mock\\\")]\\nfn trigger_file_input(_id: &str) {\\n    // In mock mode, DOM queries are not available\\n}\\n\"), \"replaceAll\": Bool(false), \"structuredPatch\": Array [Object {\"lines\": Array [String(\" use crate::utils::timers::timeout;\"), String(\" use models_types::constrained::PercentageU8;\"), String(\" use std::path::PathBuf;\"), String(\"-// Use mock-aware imports via leptos re-exports\"), String(\"-#[cfg(not(feature = \\\"mock\\\"))]\"), String(\"-use wasm_bindgen::JsCast;\"), String(\"-#[cfg(feature = \\\"mock\\\")]\"), String(\"-#[allow(unused_imports)]\"), String(\"-use crate::frontend_prelude::leptos::wasm_bindgen::JsCast;\"), String(\"-#[cfg(not(feature = \\\"mock\\\"))]\"), String(\"-use web_sys::HtmlInputElement;\"), String(\"-#[cfg(feature = \\\"mock\\\")]\"), String(\"-use crate::frontend_prelude::leptos::web_sys::HtmlInputElement;\"), String(\"-// event_target helper\"), String(\"-#[cfg(not(feature = \\\"mock\\\"))]\"), String(\"-use tachys::dom::event_target;\"), String(\"-#[cfg(feature = \\\"mock\\\")]\"), String(\"-use tachys_mock::mock_dom_helpers::event_target;\"), String(\"+// Seamless mock-aware imports via frontend_prelude\"), String(\"+use crate::frontend_prelude::event_target;\"), String(\"+use crate::frontend_prelude::wasm_bindgen::JsCast;\"), String(\"+use crate::frontend_prelude::web_sys::HtmlInputElement;\"), String(\" \"), String(\" use super::styles::Upload;\"), String